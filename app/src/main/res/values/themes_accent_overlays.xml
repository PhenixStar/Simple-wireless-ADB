<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Accent theme overlays, applied on top of Theme.WirelessADB at runtime
       (ThemeManager.applyAccent). Colors are night-qualified, so one overlay
       per accent covers both light and dark modes. -->

  <style name="ThemeOverlay.WirelessADB.Accent.Blue" parent="">
    <item name="colorPrimary">@color/accent_blue_primary</item>
    <item name="colorOnPrimary">@color/accent_blue_on_primary</item>
    <item name="colorPrimaryContainer">@color/accent_blue_container</item>
    <item name="colorOnPrimaryContainer">@color/accent_blue_on_container</item>
  </style>

